# Static environment for the fixed two-mode startup menu.
# The signing key is not stored here or in the repository.
bootcmd=reset
autostart=yes
bootmenu_default=0
bootmenu_delay=-1
fit_addr_r=0x10000000
bootmenu_0=Normal Linux operation=if fatload mmc 0:1 ${fit_addr_r} msu2-dual-mode.itb; then bootm ${fit_addr_r}#linux; fi; reset
bootmenu_1=AXI SPI test menu=if fatload mmc 0:1 ${fit_addr_r} msu2-dual-mode.itb; then bootm ${fit_addr_r}#spi-test; fi; reset
